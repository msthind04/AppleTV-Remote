<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
      Wi-Fi is what the app normally uses, but nothing here hard-requires the
      radio: a tablet or Chromebook on Ethernet can still reach an Apple TV,
      and Play would otherwise hide the app from it.
    -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!--
      The media notification runs in a foreground service because that is what
      keeps the connections to the Apple TV alive once the app leaves the
      screen. Posting it needs consent from Android 13.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Puck">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.Puck">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".KeyboardReplyReceiver"
            android:exported="false" />

        <service
            android:name=".NowPlayingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Home-screen widget: a 1x1 tile pinned to one specific Apple TV. -->
        <receiver
            android:name=".DeviceWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/device_widget_info" />
        </receiver>

        <!--
          Exported because the system launches it on the widget host's behalf
          when a widget is dragged onto the home screen; it only ever reads
          this app's own paired-device list.
        -->
        <activity
            android:name=".DeviceWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Puck">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
          Two Quick Settings tiles, each tracking one of the same "most
          recently used" slots as the launcher shortcuts (AppShortcuts) —
          Quick Settings has no per-tile configuration step at add-time the
          way widgets do, so there's no user-facing way to bind a specific
          tile to a specific device the way the widget does.
        -->
        <!--
          Long-pressing either tile opens this to pick which Apple TV it's
          pinned to — Quick Settings has no add-time configuration step the
          way widgets do, so this is the only hook Android gives for it.
        -->
        <activity
            android:name=".TileConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.Puck">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <service
            android:name=".DeviceTileOne"
            android:exported="true"
            android:icon="@drawable/ic_widget_remote"
            android:label="@string/tile_unconfigured_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".DeviceTileTwo"
            android:exported="true"
            android:icon="@drawable/ic_widget_remote"
            android:label="@string/tile_unconfigured_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
